{
  "openapi": "3.1.0",
  "info": {
    "title": "Proposal Engine Public API",
    "version": "1.0.0",
    "description": "REST API for integrating Proposal Engine with external systems. Supports audit creation, proposal retrieval, outreach triggering, client management, and webhook callbacks.",
    "contact": {
      "email": "api@proposalengine.io"
    }
  },
  "servers": [
    { "url": "/api/v1", "description": "Production" }
  ],
  "security": [{ "BearerAuth": [] }],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "API key prefixed with `pe_pub_`. Obtain from your agency dashboard."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "Audit": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["QUEUED", "RUNNING", "COMPLETE", "FAILED"] },
          "businessName": { "type": "string" },
          "businessUrl": { "type": "string" },
          "businessCity": { "type": "string", "nullable": true },
          "businessIndustry": { "type": "string", "nullable": true },
          "overallScore": { "type": "integer", "nullable": true },
          "startedAt": { "type": "string", "format": "date-time" },
          "completedAt": { "type": "string", "format": "date-time", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Finding": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "module": { "type": "string" },
          "category": { "type": "string" },
          "type": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "impactScore": { "type": "integer" },
          "confidenceScore": { "type": "integer" },
          "effortEstimate": { "type": "string", "nullable": true }
        }
      },
      "Proposal": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "auditId": { "type": "string", "format": "uuid" },
          "status": { "type": "string" },
          "executiveSummary": { "type": "string", "nullable": true },
          "pricing": { "type": "object" },
          "pdfUrl": { "type": "string", "nullable": true },
          "webLinkToken": { "type": "string" },
          "sentAt": { "type": "string", "format": "date-time", "nullable": true },
          "viewedAt": { "type": "string", "format": "date-time", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Client": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "businessName": { "type": "string" },
          "city": { "type": "string" },
          "state": { "type": "string", "nullable": true },
          "vertical": { "type": "string" },
          "status": { "type": "string" },
          "pipelineStatus": { "type": "string" },
          "painScore": { "type": "integer", "nullable": true },
          "outreachStage": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "WebhookConfig": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "url": { "type": "string", "format": "uri" },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "audit.completed", "audit.failed", "proposal.generated",
                "proposal.viewed", "email.sent", "email.opened",
                "email.clicked", "deal.closed", "client.created"
              ]
            }
          },
          "secret": { "type": "string", "description": "HMAC secret — only shown on creation" },
          "status": { "type": "string", "enum": ["active", "paused", "failed"] },
          "failureCount": { "type": "integer" },
          "lastDeliveredAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      }
    }
  },
  "paths": {
    "/audits": {
      "post": {
        "summary": "Create a new audit",
        "operationId": "createAudit",
        "tags": ["Audits"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["businessName", "businessUrl"],
                "properties": {
                  "businessName": { "type": "string" },
                  "businessUrl": { "type": "string" },
                  "city": { "type": "string" },
                  "industry": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Audit created",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Audit" } } }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Unauthorized" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/audits/{id}": {
      "get": {
        "summary": "Get audit status and results",
        "operationId": "getAudit",
        "tags": ["Audits"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Audit details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Audit" } } } },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/audits/{id}/findings": {
      "get": {
        "summary": "Get audit findings",
        "operationId": "getAuditFindings",
        "tags": ["Audits"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Findings list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "auditId": { "type": "string" },
                    "findings": { "type": "array", "items": { "$ref": "#/components/schemas/Finding" } }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/audits/{id}/proposal": {
      "get": {
        "summary": "Get generated proposal for an audit",
        "operationId": "getAuditProposal",
        "tags": ["Audits"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Proposal details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Proposal" } } } },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/outreach/{leadId}": {
      "post": {
        "summary": "Trigger outreach for a lead",
        "operationId": "triggerOutreach",
        "tags": ["Outreach"],
        "parameters": [{ "name": "leadId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Outreach triggered" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/clients": {
      "get": {
        "summary": "List clients",
        "operationId": "listClients",
        "tags": ["Clients"],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated client list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Client" } },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "page": { "type": "integer" },
                        "limit": { "type": "integer" },
                        "total": { "type": "integer" },
                        "totalPages": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/clients/{id}": {
      "get": {
        "summary": "Get client details",
        "operationId": "getClient",
        "tags": ["Clients"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Client details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Client" } } } },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/webhooks": {
      "post": {
        "summary": "Register a webhook endpoint",
        "operationId": "registerWebhook",
        "tags": ["Webhooks"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url", "events"],
                "properties": {
                  "url": { "type": "string", "format": "uri" },
                  "events": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Webhook registered", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookConfig" } } } },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" }
        }
      },
      "get": {
        "summary": "List registered webhooks",
        "operationId": "listWebhooks",
        "tags": ["Webhooks"],
        "responses": {
          "200": {
            "description": "Webhook list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/WebhookConfig" } }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/webhooks/{id}": {
      "delete": {
        "summary": "Remove a webhook endpoint",
        "operationId": "deleteWebhook",
        "tags": ["Webhooks"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "204": { "description": "Deleted" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not found" }
        }
      }
    }
  }
}
