FROM public.ecr.aws/docker/library/node:24-alpine

RUN apk add --no-cache openssl \
  && npm install --global prisma@5.22.0

WORKDIR /app
COPY prisma/schema.prisma ./prisma/schema.prisma
COPY prisma/migrations/ ./prisma/migrations/
COPY scripts/migration/run-aws-production-prisma-migrations.js ./scripts/migration/run-aws-production-prisma-migrations.js

ENV NODE_ENV=production \
    PRISMA_TELEMETRY_DISABLED=1

CMD ["node", "scripts/migration/run-aws-production-prisma-migrations.js"]
