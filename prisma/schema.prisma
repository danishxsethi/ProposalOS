  id                    String   @id @default(uuid())
  promptId              String   // ExperimentName from promptAB.ts
  winnerVariantId       String   // 'control' | 'variant'
  loserVariantId        String
  winnerAvgQuality      Float
  loserAvgQuality       Float
  qualityDeltaPct       Float    // (winner - loser) / loser * 100
  winnerAvgLatencyMs    Float
  loserAvgLatencyMs     Float
  latencyIncreasePct    Float
  winnerSampleSize      Int
  loserSampleSize       Int
  promotedAt            DateTime @default(now())
  note                  String?

  @@index([promptId])
  @@index([promotedAt])
}

// Task 3: Persistent Metrics Storage (Pipeline 17)
model Metric {
  id        String   @id @default(uuid())
  name      String   // e.g. "llm_calls_total", "llm_cost_total"
  value     Float
  labels    Json     @default("{}")  // { model, node, tenantId, ... }
  timestamp DateTime @default(now())

  @@index([name, timestamp])
  @@index([name])
}

model AuditTrailEvent {
  id                 String   @id @default(uuid())
  eventType          String
  occurredAt         DateTime @default(now())
  tenantId           String?
  auditId            String?
  proposalId         String?
  actorId            String?
  triggerSource      String?
  correlationId      String?
  traceId            String?
  targetUrlEncrypted String?
  targetUrlHash      String?
  modulesRun         Json     @default("[]")
  findingsCount      Int?
  proposalGenerated  Boolean  @default(false)
  proposalDelivered  Boolean  @default(false)
  payload            Json     @default("{}")
  previousHash       String?
  eventHash          String   @unique

  @@index([tenantId, occurredAt])
  @@index([auditId, occurredAt])
  @@index([proposalId, occurredAt])
  @@index([eventType, occurredAt])
}

model MonitoringConfig {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  type      String
  config    Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId])
}

model LocationGroup {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  locations Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId])
}

model Plugin {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  version     String
  author      String?
  config      Json?
  active      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Circuit Breaker State per tenant/stage
model CircuitBreakerState {
  id                String   @id @default(uuid())
  tenantId          String
  stage             String   // PipelineStage enum value
  state             String   @default("CLOSED") // CLOSED, OPEN, HALF_OPEN
  errorCount        Int      @default(0)
  successCount      Int      @default(0)
  totalAttempts     Int      @default(0)
  lastErrorAt       DateTime?
  lastStateChangeAt DateTime  @default(now())
  halfOpenAttempts  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, stage])
  @@index([tenantId, state])
  @@index([stage])
}

// Dead Letter Queue for permanently failed prospects
model DeadLetterQueue {
  id           String   @id @default(uuid())
  tenantId     String
  prospectId   String   @unique
  originalStatus String
  failureCount Int      @default(0)
  lastError    String   @db.Text
  lastErrorAt  DateTime
  createdAt    DateTime @default(now())
  processedAt  DateTime?
  status       String   @default("pending") // pending, retrying, resolved, discarded

  @@index([tenantId, status])
  @@index([createdAt])
}

// ===== Retention & Client Portal Models =====

model ClientDashboard {
  id             String   @id @default(uuid())
  tenantId       String
  auditId        String   @unique
  healthScore    Int
  lastScanDate   DateTime
  previousScore  Int?
  scoreChange    Int?
  findingsFixed  Int
  findingsTotal  Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
  @@index([auditId])
}

model UpsellOpportunity {
  id            String   @id @default(uuid())
  tenantId      String
  proposalId    String
  triggerType   String   // 'competitor', 'scheduled_audit', 'manual'
  triggerReason String
  status        String   // 'created', 'sent', 'viewed', 'accepted', 'rejected'
  sentAt        DateTime?
  acceptedAt    DateTime?
  dealValue     Decimal? @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  @@index([tenantId, status])
  @@index([triggerType])
}

model NotificationPreference {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  emailEnabled Boolean  @default(true)
  smsEnabled   Boolean  @default(false)
  frequency    String   // 'instant', 'daily', 'weekly', 'never'
  types        Json     // { proposalReady: true, proposalViewed: true, nps: true, upsell: false }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, userId])
}

model ScheduledAuditRun {
  id              String   @id @default(uuid())
  tenantId        String
  scheduleId      String
  auditId         String
  previousAuditId String?
  status          String   // 'queued', 'running', 'completed', 'failed'
  comparisonReport Json?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([tenantId])
  @@index([scheduleId])
  @@index([auditId])
}

model CompetitorSignal {
  id              String   @id @default(uuid())
  tenantId        String
  leadId          String?
  signalType      String   // 'competitor_new_review', 'competitor_rating_change', etc.
  priority        String   // 'high', 'medium', 'low'
  competitorName  String
  competitorUrl   String?
  signalData      Json
  outreachTriggered Boolean @default(false)
  upsellProposalId String?
  detectedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([tenantId, signalType, detectedAt])
  @@index([leadId])
}

model ReEngagementCampaign {
  id           String   @id @default(uuid())
  tenantId     String
  proposalId   String
  status       String   // 'pending', 'sent', 'completed', 'converted'
  step         Int      @default(0) // 1, 2, 3 for email sequence
  lastSentAt   DateTime?
  convertedAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([tenantId, status])
  @@index([proposalId])
}

model WinBackCampaign {
  id           String   @id @default(uuid())
  tenantId     String
  formerTenantId String
  status       String   // 'pending', 'sent', 'completed', 'converted'
  step         Int      @default(0)
  offerCode    String?
  lastSentAt   DateTime?
  convertedAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([tenantId, status])
  @@index([formerTenantId])
}

// ============================================================================
// PROMPT MANAGEMENT & SELF-EVOLVING SYSTEM
// ============================================================================

// Prompt Version Control - Git-like versioning for prompts
model PromptVersion {
  id                  String   @id @default(uuid())
  versionHash         String   @unique // SHA256 of nodeId + promptText + timestamp
  nodeId              String   // e.g., "executive_summary", "pricing_generation"
  promptText          String   @db.Text
  createdBy           String   // User ID or system
  parentVersionHash   String?  // Parent version for lineage tracking
  branchName          String   @default("main") // Support branching
  changelog           String
  isActive            Boolean  @default(false) // Only one active version per node
  environment         String   @default("production") // dev, staging, production
  metadata            Json     @default("{}") // Additional metadata
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Multi-Tenancy
  tenantId            String?  // Null = system-wide prompt
  tenant              Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relations
  performanceLogs     PromptPerformanceLog[]
  experimentVariants  ABVariant[]
  predictions         Prediction[]

  @@index([nodeId])
  @@index([versionHash])
  @@index([isActive])
  @@index([environment])
  @@index([tenantId])
  @@index([createdAt])
}

// Append-Only Performance Log - Tracks every LLM call
model PromptPerformanceLog {
  id                  String   @id @default(uuid())
  timestamp           DateTime @default(now())
  promptVersionHash   String
  nodeId              String
  qualityScore        Float    // 0-100 score from QA evaluation
  downstreamImpact    Float    // 0-100 impact on downstream metrics
  costUSD             Float    // Actual cost in USD
  latencyMs           Int      // Response time in milliseconds
  inputTokens         Int      // Tokens in prompt
  outputTokens        Int      // Tokens in response
  experimentId        String?  // If part of A/B test
  variantId           String?  // If part of A/B test
  metadata            Json     @default("{}") // Model, temperature, etc.

  // Multi-Tenancy
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relations
  promptVersion       PromptVersion @relation(fields: [promptVersionHash], references: [versionHash], onDelete: Cascade)

  @@index([promptVersionHash])
  @@index([nodeId])
  @@index([experimentId])
  @@index([timestamp])
  @@index([tenantId])
}

// A/B Testing Framework - Experiment management
model ABExperiment {
  id                      String   @id @default(uuid())
  name                    String
  nodeId                  String   // Which prompt node is being tested
  status                  String   @default("active") // active, completed, paused
  startDate               DateTime @default(now())
  endDate                 DateTime?
  winnerVariantId         String?  // Winning variant after completion
  statisticalSignificance Float?   // p-value if completed
  metadata                Json     @default("{}")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Multi-Tenancy
  tenantId                String
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relations
  variants                ABVariant[]

  @@index([nodeId])
  @@index([status])
  @@index([tenantId])
}

// A/B Testing Framework - Variant definitions
model ABVariant {
  id                      String   @id @default(uuid())
  experimentId            String
  promptVersionHash       String
  trafficPercentage       Int      // 0-100
  sampleSize              Int      @default(0) // Number of requests routed here
  avgQualityScore         Float?   // Running average
  avgDownstreamImpact     Float?   // Running average
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relations
  experiment              ABExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  promptVersion           PromptVersion @relation(fields: [promptVersionHash], references: [versionHash])

  @@index([experimentId])
  @@index([promptVersionHash])
}

// Predictive Intelligence - Storage for predictions
model Prediction {
  id                      String   @id @default(uuid())
  auditId                 String?  // Associated audit
  predictionType          String   // traffic, ranking, competitor, revenue, algorithm
  predictedValue          Float
  confidenceIntervalLower Float
  confidenceIntervalUpper Float
  actualValue             Float?   // Set when observed
  observedAt              DateTime? // When actual was recorded
  predictionDate          DateTime @default(now())
  metadata                Json     @default("{}")
  createdAt               DateTime @default(now())

  // Multi-Tenancy
  tenantId                String
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relations
  promptVersion           PromptVersion? @relation(fields: [promptVersionHash], references: [versionHash])
  promptVersionHash       String?

  @@index([auditId])
  @@index([predictionType])
  @@index([tenantId])
  @@index([predictionDate])
}

// What-If Scenarios - Scenario planning results
model Scenario {
  id                      String   @id @default(uuid())
  auditId                 String   // Associated audit
  selectedRecommendations Json     // Array of recommendation IDs
  projectedROI            Float    // Expected ROI percentage
  projectedTimeline       String   // e.g., "3 months"
  projectedTraffic        Int      // Expected traffic increase
  confidenceIntervals     Json     // { roi: [min, max], traffic: [min, max] }
  comparisonToBaseline    Json     // { roiDelta, trafficDelta, timelineDelta }
  calculationTimeMs       Int      // Time to calculate
  createdAt               DateTime @default(now())

  // Multi-Tenancy
  tenantId                String
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([tenantId])
  @@index([createdAt])
}
